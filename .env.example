# Values are supplied as environment variables; the application does not auto-load this file.
CAMPUSBRIDGE_ENV=development
CAMPUSBRIDGE_DATABASE_PATH=data/development/campusbridge.sqlite3
CAMPUSBRIDGE_KNOWLEDGE_DATABASE_PATH=data/development/campusbridge.knowledge.sqlite3
# MySQL opt-in: supply CAMPUSBRIDGE_DATABASE_URL through a secret manager/process environment.
# Run migrations with separate CAMPUSBRIDGE_MIGRATION_DATABASE_URL, then start with a DML-only account.
CAMPUSBRIDGE_DB_POOL_SIZE=10
CAMPUSBRIDGE_DB_MAX_OVERFLOW=10
CAMPUSBRIDGE_DB_POOL_TIMEOUT=5
CAMPUSBRIDGE_DB_POOL_RECYCLE=1800
CAMPUSBRIDGE_DB_CONNECT_TIMEOUT=5
CAMPUSBRIDGE_DB_IO_TIMEOUT=10
CAMPUSBRIDGE_MODEL_PROVIDER=mock
CAMPUSBRIDGE_SEED_DEMO=true
CAMPUSBRIDGE_KNOWLEDGE_BACKEND=fts5
CAMPUSBRIDGE_RETRIEVAL_MODE=bm25
# Optional Redis (install .[redis]). Disabled by default for lightweight development.
CAMPUSBRIDGE_REDIS_CACHE_ENABLED=false
CAMPUSBRIDGE_REDIS_RATE_LIMIT_ENABLED=false
# Supply CAMPUSBRIDGE_REDIS_URL via process environment / secret manager (redis:// or rediss://).
CAMPUSBRIDGE_REDIS_NAMESPACE=campusbridge:d2
CAMPUSBRIDGE_REDIS_TIMEOUT=0.15
CAMPUSBRIDGE_REDIS_MAX_CONNECTIONS=32
CAMPUSBRIDGE_REDIS_CACHE_TTL=120
CAMPUSBRIDGE_LOGIN_LIMIT=10
CAMPUSBRIDGE_LOGIN_PEER_LIMIT=100
CAMPUSBRIDGE_LOGIN_WINDOW_SECONDS=60
CAMPUSBRIDGE_MESSAGE_LIMIT=20
CAMPUSBRIDGE_MESSAGE_WINDOW_SECONDS=60
CAMPUSBRIDGE_RATE_LIMIT_STATUS=429
# Optional local CPU embeddings; the API never downloads weights.
# CAMPUSBRIDGE_EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
# CAMPUSBRIDGE_EMBEDDING_THREADS=2
# CAMPUSBRIDGE_RETRIEVAL_CANDIDATE_K=20
# Stage B independent Dev selection; used when opting into dense/hybrid.
CAMPUSBRIDGE_DENSE_MIN_SCORE=0.50
# CAMPUSBRIDGE_RETRIEVAL_FALLBACK=error
CAMPUSBRIDGE_ORCHESTRATION=sequential
CAMPUSBRIDGE_MAX_PARALLEL_AGENTS=2
CAMPUSBRIDGE_MAX_TASK_EXECUTIONS=16
CAMPUSBRIDGE_MAX_TURN_TOKEN_RESERVATION=131072
# To opt in: change MODEL_PROVIDER to openai-compatible and supply all three values in the process environment.
CAMPUSBRIDGE_ENDPOINT=https://provider.example/v1
CAMPUSBRIDGE_MODEL=
CAMPUSBRIDGE_API_KEY=
# Optional DeepSeek control only; use disabled to avoid its default reasoning token budget.
# CAMPUSBRIDGE_THINKING_MODE=disabled
CAMPUSBRIDGE_JSON_MODE=true
CAMPUSBRIDGE_MAX_TOKENS_PARAMETER=max_tokens
# Real-provider environment defaults: single call 20 seconds, whole run 90 seconds.
# CAMPUSBRIDGE_MODEL_TIMEOUT=20
# CAMPUSBRIDGE_RUN_TIMEOUT=90
# Docker Compose: defaults work without creating an .env or supplying passwords.
# Random service passwords are bootstrapped into private named volumes.
CAMPUSBRIDGE_WEB_PORT=8080
CAMPUSBRIDGE_IMAGE_TAG=d3-local
CAMPUSBRIDGE_BUILD_TARGET=runtime
# Dense/Hybrid: use deploy/compose.dense.yaml and an existing local model path.
# CAMPUSBRIDGE_BGE_MODEL_DIR=/path/to/bge-small-zh-v1.5
