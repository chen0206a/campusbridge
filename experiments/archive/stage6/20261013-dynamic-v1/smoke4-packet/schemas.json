{
  "intent": {
    "$defs": {
      "IntentKind": {
        "enum": [
          "GENERAL",
          "SUPPORT",
          "CAMPUS_SERVICE",
          "URGENT"
        ],
        "title": "IntentKind",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "kind": {
        "const": "intent",
        "default": "intent",
        "title": "Kind",
        "type": "string"
      },
      "intent": {
        "$ref": "#/$defs/IntentKind"
      },
      "needs_knowledge": {
        "title": "Needs Knowledge",
        "type": "boolean"
      },
      "needs_human_support": {
        "default": false,
        "title": "Needs Human Support",
        "type": "boolean"
      }
    },
    "required": [
      "intent",
      "needs_knowledge"
    ],
    "title": "IntentOutput",
    "type": "object"
  },
  "risk": {
    "$defs": {
      "RiskLevel": {
        "enum": [
          "LOW",
          "MODERATE",
          "HIGH",
          "UNKNOWN"
        ],
        "title": "RiskLevel",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "kind": {
        "const": "risk",
        "default": "risk",
        "title": "Kind",
        "type": "string"
      },
      "level": {
        "$ref": "#/$defs/RiskLevel"
      },
      "needs_human_support": {
        "title": "Needs Human Support",
        "type": "boolean"
      },
      "reason_codes": {
        "items": {
          "enum": [
            "EXPLICIT_DANGER",
            "MODEL_CONCERN",
            "ASSESSMENT_UNAVAILABLE",
            "NO_SIGNAL",
            "HUMAN_REQUEST"
          ],
          "type": "string"
        },
        "title": "Reason Codes",
        "type": "array"
      }
    },
    "required": [
      "level",
      "needs_human_support",
      "reason_codes"
    ],
    "title": "RiskOutput",
    "type": "object"
  },
  "review": {
    "$defs": {
      "Verdict": {
        "enum": [
          "PASS",
          "RETRY",
          "REJECT"
        ],
        "title": "Verdict",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "kind": {
        "const": "review",
        "default": "review",
        "title": "Kind",
        "type": "string"
      },
      "candidate_id": {
        "title": "Candidate Id",
        "type": "string"
      },
      "content_hash": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Content Hash",
        "type": "string"
      },
      "verdict": {
        "$ref": "#/$defs/Verdict"
      },
      "reason_codes": {
        "default": [],
        "items": {
          "enum": [
            "UNSAFE_INSTRUCTION",
            "DIAGNOSIS",
            "PRIVACY_DISCLOSURE",
            "INTERNAL_LABEL",
            "SAFETY_GUIDANCE_MISSING",
            "MOCK_REJECTION",
            "APPROVED_TEMPLATE",
            "UNSUPPORTED_CLAIM"
          ],
          "type": "string"
        },
        "title": "Reason Codes",
        "type": "array"
      },
      "authority": {
        "default": "MODEL",
        "enum": [
          "MODEL",
          "RULE",
          "TEMPLATE"
        ],
        "title": "Authority",
        "type": "string"
      },
      "citations_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Citations Hash"
      }
    },
    "required": [
      "candidate_id",
      "content_hash",
      "verdict"
    ],
    "title": "ReviewOutput",
    "type": "object"
  },
  "task_plan": {
    "$defs": {
      "AgentName": {
        "enum": [
          "IntentAgent",
          "RiskAgent",
          "ContextAgent",
          "ResponseAgent",
          "OutputReviewer",
          "Delivery"
        ],
        "title": "AgentName",
        "type": "string"
      },
      "Task": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "agent",
              "arbitration",
              "attention",
              "delivery",
              "template"
            ],
            "title": "Kind",
            "type": "string"
          },
          "agent": {
            "anyOf": [
              {
                "$ref": "#/$defs/AgentName"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "status": {
            "$ref": "#/$defs/TaskStatus",
            "default": "PENDING"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "safety_checkpoint": {
            "default": false,
            "title": "Safety Checkpoint",
            "type": "boolean"
          },
          "started_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started Ms"
          },
          "finished_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Finished Ms"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Failure Code"
          }
        },
        "required": [
          "task_id",
          "kind",
          "reason"
        ],
        "title": "Task",
        "type": "object"
      },
      "TaskDependency": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "depends_on": {
            "title": "Depends On",
            "type": "string"
          },
          "allowed_statuses": {
            "default": [
              "SUCCEEDED",
              "DEGRADED"
            ],
            "items": {
              "$ref": "#/$defs/TaskStatus"
            },
            "title": "Allowed Statuses",
            "type": "array"
          }
        },
        "required": [
          "task_id",
          "depends_on"
        ],
        "title": "TaskDependency",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "PENDING",
          "RUNNING",
          "SUCCEEDED",
          "DEGRADED",
          "FAILED",
          "SKIPPED",
          "BLOCKED",
          "CANCELLED"
        ],
        "title": "TaskStatus",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "plan_id": {
        "title": "Plan Id",
        "type": "string"
      },
      "version": {
        "default": "campusbridge-task-plan-v1",
        "title": "Version",
        "type": "string"
      },
      "orchestration": {
        "enum": [
          "sequential",
          "dynamic"
        ],
        "title": "Orchestration",
        "type": "string"
      },
      "independent_analysis": {
        "title": "Independent Analysis",
        "type": "boolean"
      },
      "tasks": {
        "items": {
          "$ref": "#/$defs/Task"
        },
        "title": "Tasks",
        "type": "array"
      },
      "dependencies": {
        "default": [],
        "items": {
          "$ref": "#/$defs/TaskDependency"
        },
        "title": "Dependencies",
        "type": "array"
      },
      "max_task_executions": {
        "title": "Max Task Executions",
        "type": "integer"
      },
      "max_model_calls": {
        "title": "Max Model Calls",
        "type": "integer"
      },
      "max_token_reservation": {
        "title": "Max Token Reservation",
        "type": "integer"
      }
    },
    "required": [
      "orchestration",
      "independent_analysis",
      "tasks",
      "max_task_executions",
      "max_model_calls",
      "max_token_reservation"
    ],
    "title": "ExecutionPlan",
    "type": "object"
  },
